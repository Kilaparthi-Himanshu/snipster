<?xml version="1.0" encoding="utf-8"?>

<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

    <Identity
        Name="Snipster"
        Publisher="CN=SnipsterDev"
        Version="1.0.2.0" />

    <Properties>
        <DisplayName>Snipster</DisplayName>
        <PublisherDisplayName>Snipster</PublisherDisplayName>
        <Description>Temporary screenshot utility</Description>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily
            Name="Windows.Desktop"
            MinVersion="10.0.19041.0"
            MaxVersionTested="10.0.22621.0" />
    </Dependencies>

    <Resources>
        <Resource Language="en-us" />
    </Resources>

    <Applications>
        <Application
            Id="Snipster"
            Executable="snipster.exe"
            EntryPoint="Windows.FullTrustApplication">

            <uap:VisualElements
                DisplayName="Snipster"
                Description="Temporary screenshot utility"
                BackgroundColor="transparent"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png" />

            <Extensions>

                <!-- Snipster callback protocol -->
                <uap:Extension Category="windows.protocol">
                    <uap:Protocol Name="snipster" DesiredView="default">
                        <uap:DisplayName>Snipster Capture Callback</uap:DisplayName>
                    </uap:Protocol>
                </uap:Extension>

                <!-- Start Snipster automatically with Windows -->
                <uap5:Extension
                    Category="windows.startupTask"
                    Executable="snipster.exe"
                    EntryPoint="Windows.FullTrustApplication">

                    <uap5:StartupTask
                        TaskId="SnipsterStartup"
                        Enabled="true"
                        DisplayName="Snipster" />

                </uap5:Extension>

            </Extensions>

        </Application>
    </Applications>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
